{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:primer:report-definition:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "type": "object",
      "properties": {
        "columns": {
          "const": 12
        },
        "row_height_px": {
          "type": "integer",
          "minimum": 24,
          "maximum": 120
        }
      },
      "required": [
        "columns",
        "row_height_px"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "widgets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "value",
                    "table",
                    "line",
                    "bar",
                    "pie",
                    "confusion_matrix",
                    "boxplot",
                    "text",
                    "divider",
                    "heading"
                  ]
                },
                "layout": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                "query": {
                  "type": "object",
                  "properties": {
                    "measurement": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "inputs": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "threshold_policy": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cohort": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "target_class": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lunit_thresholds": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": false,
                      "properties": {
                        "default": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "findings": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 10,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "overrides": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 10,
                          "additionalProperties": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        }
                      }
                    },
                    "field_semantics": {
                      "type": "object",
                      "maxProperties": 80,
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "interpretation": {
                            "enum": [
                              "identifier",
                              "integer",
                              "measurement",
                              "age",
                              "binary",
                              "nominal",
                              "ordered",
                              "date_time",
                              "duration",
                              "free_text"
                            ]
                          },
                          "unit": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "aliases": {
                            "type": "array",
                            "maxItems": 128,
                            "items": {
                              "type": "string",
                              "maxLength": 128
                            }
                          },
                          "categories": {
                            "type": "array",
                            "maxItems": 128,
                            "items": {
                              "type": "string",
                              "maxLength": 128
                            }
                          },
                          "closed": {
                            "type": "boolean"
                          },
                          "bins": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                              "type": "array",
                              "minItems": 3,
                              "maxItems": 3
                            }
                          },
                          "positive_class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "revision": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "label",
                          "interpretation",
                          "unit",
                          "aliases",
                          "categories",
                          "closed",
                          "bins",
                          "positive_class",
                          "revision"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "measurement",
                    "inputs"
                  ],
                  "additionalProperties": false
                },
                "window": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^(D|W|M|Y)(-[0-9]+)?$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^(D|W|M|Y)(-[0-9]+)?$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "bucket": {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ]
                },
                "controls": {
                  "type": "object",
                  "properties": {
                    "date_range": {
                      "const": true
                    },
                    "filters": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      }
                    },
                    "compare_by": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      }
                    }
                  },
                  "required": [
                    "date_range",
                    "filters",
                    "compare_by"
                  ],
                  "additionalProperties": false
                },
                "default_compare_by": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "ci": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "enabled"
                  ],
                  "additionalProperties": false
                },
                "benchmarks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "label",
                      "value",
                      "unit"
                    ],
                    "additionalProperties": false
                  }
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  }
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "whiskers": {
                      "enum": [
                        "min_max",
                        "p5_p95",
                        "tukey"
                      ]
                    },
                    "normalization": {
                      "enum": [
                        "count",
                        "row_percent",
                        "column_percent"
                      ]
                    },
                    "donut": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "export": {
                  "enum": [
                    "full",
                    "summary"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000
                }
              },
              "required": [
                "id",
                "title",
                "type",
                "layout"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "text",
                          "divider",
                          "heading"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "query": false,
                      "window": false,
                      "bucket": false,
                      "controls": false,
                      "default_compare_by": false,
                      "ci": false,
                      "benchmarks": false,
                      "columns": false,
                      "options": false,
                      "export": false
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "text"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "text"
                          ]
                        },
                        "else": {
                          "properties": {
                            "text": false
                          }
                        }
                      }
                    ]
                  },
                  "else": {
                    "required": [
                      "query",
                      "window",
                      "controls",
                      "ci",
                      "export"
                    ],
                    "properties": {
                      "text": false
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "widgets"
        ],
        "additionalProperties": false
      }
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/properties/sections/items/properties/widgets/items"
      }
    }
  },
  "required": [
    "schema_version",
    "project",
    "id",
    "title",
    "grid"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "sections"
      ]
    },
    {
      "required": [
        "widgets"
      ]
    }
  ]
}
