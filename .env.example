# ================================
# 🫁 PRIMER-LLM — Environment Variables
# Copy this file to .env and fill in your values
# ================================

# ── Django ─────────────────────────────────────────────────
# Generate a real secret key:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins that may POST to Django (CSRF protection).
# Must include the scheme (https://) and match how users access the site.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://192.168.1.207

# -- Database --------------------------------------------------
# SQLite remains the default when DATABASE_ENGINE is unset or sqlite.
# Set DATABASE_ENGINE=postgres to use PostgreSQL for application data.
DATABASE_ENGINE=sqlite
DATABASE_NAME=/app/db/db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_SSLMODE=
DATABASE_CONN_MAX_AGE=0
DATABASE_CONN_HEALTH_CHECKS=False

# Audit data can use a separate PostgreSQL database while preserving
# the Django "audit" database alias.
AUDIT_DATABASE_ENGINE=sqlite
AUDIT_DATABASE_NAME=/app/db/audit.sqlite3
AUDIT_DATABASE_USER=
AUDIT_DATABASE_PASSWORD=
AUDIT_DATABASE_HOST=
AUDIT_DATABASE_PORT=
AUDIT_DATABASE_SSLMODE=
AUDIT_DATABASE_CONN_MAX_AGE=0
AUDIT_DATABASE_CONN_HEALTH_CHECKS=False

# Optional Docker PostgreSQL service bootstrap. Used only when running the
# Compose postgres service for local/internal-review deployments.
POSTGRES_DB=primer_admin
POSTGRES_USER=primer_admin
POSTGRES_PASSWORD=change-me-postgres-admin-password
POSTGRES_APP_DB=primer_app
POSTGRES_APP_USER=primer_app_user
POSTGRES_APP_PASSWORD=change-me-app-db-password
POSTGRES_AUDIT_DB=primer_audit
POSTGRES_AUDIT_USER=primer_audit_user
POSTGRES_AUDIT_PASSWORD=change-me-audit-db-password

# ── Django Superuser (created automatically on first start) ──
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ── Gunicorn ───────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ── Ollama / LLM ──────────────────────────────────────────
# The Ollama server URL — accessible from inside the Docker network.
# If Ollama runs on the Docker host machine, use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:32b-q4_K_M
OLLAMA_API_KEY=dummy
OLLAMA_MAX_WORKERS=8
# Set True only when HTTP transport is isolated and documented.
LLM_ALLOW_INSECURE_TRANSPORT=False

# ── Email (for report emailing) ────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PRIMER-LLM <your-email@gmail.com>

# ── API Authentication ────────────────────────────────────
# Shared secret between Django and FastAPI. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change-me-to-a-random-secret
API_REQUIRE_AUTH=True
FASTAPI_CORS_ORIGINS=https://localhost
# ── Excel Decryption ──────────────────────────────────────
XLSX_DECRYPT_PASSWORD=change-me

# ── Nginx Ports ────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Agent API is disabled by default; administrators enable it at /settings/api/.
# Public API keys are managed there, separate from API_SECRET_KEY.
# Verify sandboxed Chromium with manage.py check_api_pdf before enabling.
