# PRIMER-LLM Windows local profile configuration (template, no secrets).
# `init` copies this to %LOCALAPPDATA%\PRIMER-LLM\config\local.env and fills
# the two secrets with random values. The real file lives outside Git.
#
# Only the keys below are read. Database engine, bind address (127.0.0.1),
# Ollama URL (http://127.0.0.1:11434/v1), API authentication and DEBUG are
# fixed by the launcher and cannot be overridden here.

# Generated by init. Do not share. Delete this file and re-run init to rotate.
DJANGO_SECRET_KEY=
API_SECRET_KEY=

# Local model. Start with qwen3:4b; try qwen3:8b only after 4b works.
OLLAMA_MODEL=qwen3:4b
# Concurrent LLM requests. Keep 1 on an 8 GB GPU.
OLLAMA_MAX_WORKERS=1
# True appends Qwen3's /no_think switch (faster, may change grading quality).
LLM_DISABLE_THINKING=False

# Loopback ports for Django (browser) and FastAPI (internal).
DJANGO_PORT=8000
API_PORT=1221

# Only needed for password-protected synthetic XLSX test files.
XLSX_DECRYPT_PASSWORD=

DEFAULT_FROM_EMAIL=PRIMER-LLM Local <primer@localhost>
